<view class="page sheet-page" style="{{theme}}">
  <view class="muted small ep-sub">用你训练的地点命名（比如“家里”或“健身房”），然后勾选你在那里有的器械。</view>
  <input class="field" value="{{name}}" maxlength="40" placeholder="配置名称" placeholder-class="ph" bindinput="onName" />
  <view style="height:12px"></view>
  <view class="chips-wrap">
    <view wx:for="{{items}}" wx:key="k" class="chip {{item.on ? 'on' : ''}}" hover-class="hv" data-i="{{index}}" bindtap="onToggle">{{item.label}}</view>
  </view>
  <view class="dim small ep-foot">自重动作始终可用，除非需要引体向上杆或卧推凳。</view>
  <view style="height:14px"></view>
  <view class="btn primary" hover-class="hv" bindtap="onSave"><text>保存</text></view>
  <toast-x />
</view>
