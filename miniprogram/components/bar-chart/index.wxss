/* index.css .mrow, self-contained so the component does not depend on app.wxss carrying it */
:host{display:block}
.mrow{display:flex;align-items:center;gap:9px;padding:5px 0}
.mrow.two{min-height:48px}
.mrow.tap:active{opacity:.6}
.nm{flex:1;min-width:0;font-size:14px;color:var(--label)}
.nm-1{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.mrow.two .nm{line-height:1.35}
.nm .b{font-weight:600}
.nm-tag{font-size:11px;margin-left:6px}
.nm-2{display:block;font-weight:400}
.bar{width:74px;height:5px;border-radius:3px;background:var(--surface-2);flex:none;overflow:hidden}
.bar .fill{display:block;height:100%;background:var(--acc);border-radius:3px}
.v{font-size:12px;color:var(--label-2);min-width:52px;text-align:right;flex:none}
.v-sub{display:block;font-weight:400}
.dim{color:var(--label-3)}
.small{font-size:13px;line-height:1.38}
.v .small{font-size:11px}
