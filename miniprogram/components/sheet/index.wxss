/* frontend/src/index.css .mback / .sheet / .center */
.sh-root{position:fixed;top:0;left:0;right:0;bottom:0;z-index:100}
.sh-mask{position:absolute;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.4);opacity:0;transition:opacity .25s}
.sh-panel{
  position:absolute;left:0;right:0;bottom:0;background:var(--sheet-bg);color:var(--label);
  border-radius:var(--r-xl) var(--r-xl) 0 0;
  padding:8px 18px calc(20px + env(safe-area-inset-bottom));
  transform:translateY(100%);transition:transform .34s var(--ease);
  box-sizing:border-box;overflow:hidden;
}
.sh-root.open .sh-mask{opacity:1}
.sh-root.open .sh-panel{transform:none}
.sh-scroll{width:100%}
.sh-foot{height:8px}
.sh-root.is-center .sh-panel{
  left:50%;right:auto;top:50%;bottom:auto;width:84vw;max-width:300px;
  border-radius:var(--r-lg);padding:20px;background:var(--surface);
  transform:translate(-50%,-50%) scale(.94);opacity:0;
  transition:transform .28s var(--ease),opacity .28s;
  box-shadow:0 20px 60px -12px rgba(0,0,0,.5);
}
.sh-root.is-center.open .sh-panel{transform:translate(-50%,-50%) scale(1);opacity:1}
