.pc-page{padding:0;height:100vh;display:flex;flex-direction:column;background:#000}
.pp-compare{position:relative;flex:1;min-height:0;overflow:hidden;background:#000}
.pp-img{position:absolute;left:0;top:0;width:100%;height:100%;background:#000}
.pp-clip{position:absolute;left:0;top:0;bottom:0;overflow:hidden}
.pp-handle{position:absolute;top:0;bottom:0;width:0;display:flex;align-items:center;justify-content:center}
.pp-line{position:absolute;top:0;bottom:0;left:-1px;width:2px;background:#fff;box-shadow:0 0 0 1px rgba(0,0,0,.3)}
.pp-grip{position:relative;flex:none;width:36px;height:36px;border-radius:99px;background:#fff;box-shadow:0 1px 6px rgba(0,0,0,.4)}
.pp-label{position:absolute;bottom:calc(14px + env(safe-area-inset-bottom));font-size:12px;font-weight:600;color:#fff;background:rgba(0,0,0,.55);padding:4px 9px;border-radius:99px}
.pp-label-before{left:10px}
.pp-label-after{right:10px}
