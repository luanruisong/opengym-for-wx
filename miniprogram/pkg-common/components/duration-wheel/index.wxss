.dw{position:relative;height:200px;margin:4px auto 16px;max-width:320px}
.dw-pv{width:100%;height:200px}
.dw-band{height:40px;border-radius:10px;background:var(--label-tint)}
.dw-band::before,.dw-band::after{border:none}
.dw-mask{background-image:linear-gradient(180deg,var(--sheet-bg),rgba(0,0,0,0)),linear-gradient(0deg,var(--sheet-bg),rgba(0,0,0,0))}
.dw-it{height:40px;line-height:40px;font-size:22px;font-variant-numeric:tabular-nums;color:var(--label);text-align:right;padding-right:calc(50% + 2px)}
.dw-it.out{color:var(--label-4)}
.dw-unit{position:absolute;top:80px;height:40px;line-height:40px;font-size:17px;font-weight:600;color:var(--label);pointer-events:none}
.dw-unit-m{left:calc(25% + 8px)}
.dw-unit-s{left:calc(75% + 8px)}
