.wmedia{margin-bottom:12px;text-align:left}
.wmedia-h{margin:0 4px 8px}
.wmedia-item{position:relative;overflow:hidden}
.wmedia-ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--label-3);font-size:22px;background:var(--surface-2)}
.wmedia-kind{position:absolute;right:5px;bottom:5px;width:20px;height:20px;border-radius:50%;background:rgba(0,0,0,.55);color:#fff;font-size:10px;display:flex;align-items:center;justify-content:center}
.wmedia-add.disabled{opacity:.5;pointer-events:none}
.wmedia-note{margin:6px 4px 0}
