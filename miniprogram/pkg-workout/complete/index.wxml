<view class="page sheet-page" style="{{theme}}">
  <view class="cpl">
    <view class="cpl-ico"><icon-x name="checkCircle" /></view>
    <view class="h3 cpl-t">训练全部完成！</view>
    <view class="muted small cpl-s">所有动作都完成了，干得漂亮！可以结束训练，如果还有余力就再加一个。</view>
    <view class="btn primary" hover-class="hv" bindtap="onFinish"><icon-x name="flag" /><text>结束训练</text></view>
    <view class="btn mt8" hover-class="hv" bindtap="onContinue"><text>继续训练</text></view>
  </view>
  <toast-x />
</view>
