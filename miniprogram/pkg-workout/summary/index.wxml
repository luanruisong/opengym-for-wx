<view class="page sheet-page" style="{{theme}}">
  <block wx:if="{{ready}}">
    <view class="sum-ico"><icon-x name="trophy" /></view>
    <view class="tiles">
      <view class="tile"><view class="l">时长</view><view class="v sum-v">{{duration}}</view></view>
      <view class="tile"><view class="l">总量</view><view class="v sum-v">{{volume}}</view></view>
      <view class="tile"><view class="l">组数</view><view class="v sum-v">{{sets}}</view></view>
      <view class="tile"><view class="l">纪录</view><view class="v sum-pr">{{prCount}}</view></view>
    </view>
    <view wx:if="{{hasPrs}}" class="mb12">
      <view wx:for="{{prs}}" wx:key="k" class="small accent row sum-line"><icon-x name="trophy" /><text>新纪录：{{item.name}}</text></view>
      <view wx:for="{{e1prs}}" wx:key="k" class="small accent row sum-line"><icon-x name="chartLine" /><text>最佳预估 1RM：{{item.name}} · {{item.est}}</text></view>
    </view>
    <view class="sec">你刚刚练了什么</view>
    <body-map load="{{load}}" body="{{body}}" />
    <view class="mt16" />
    <block wx:if="{{compare.length}}">
      <view class="sec">上次与下次</view>
      <view class="list mb16">
        <view wx:for="{{compare}}" wx:key="id" class="item sum-item">
          <view class="row between">
            <view class="tt bold ellipsis grow">{{item.name}}</view>
            <view wx:if="{{item.trendIcon}}" style="color:{{item.trendColor}}"><icon-x name="{{item.trendIcon}}" /></view>
            <view wx:else class="tag nocap">第一次</view>
          </view>
          <view class="small">{{item.today}}</view>
          <view wx:if="{{item.last}}" class="small dim">{{item.last}}</view>
          <view wx:if="{{item.next}}" class="small accent">{{item.next}}</view>
        </view>
      </view>
    </block>
    <block wx:if="{{cardio.length}}">
      <view class="sec">有氧</view>
      <view class="list mb16">
        <view wx:for="{{cardio}}" wx:key="k" class="item sum-item">
          <view class="tt bold">{{item.name}}</view>
          <view class="small">{{item.sets}}</view>
        </view>
      </view>
    </block>
    <workout-media w="{{w}}" hint />
    <view class="btn primary mt16" hover-class="hv" bindtap="onNice"><text>太棒了！</text></view>
  </block>
  <toast-x />
</view>
