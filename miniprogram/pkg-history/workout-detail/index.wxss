.wd-sec{margin:2px 0 8px;padding-bottom:6px;border-bottom:1px solid var(--sep)}
.wd-sec-n{font-weight:600}
.wd-sec-n>text{margin-left:7px}
.wd-tt{font-weight:600;display:flex;align-items:center;flex-wrap:wrap}
.wd-tt .pr{margin-left:6px}
.wd-pin{font-size:12px;margin-right:4px;color:var(--yellow)}
.wd-chev{align-self:center}
.wd-ex{padding:4px}
.wmedia{margin:6px 0 10px}
.wmedia-h{margin-bottom:8px}
.wmedia-ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:22px;color:var(--label-3)}
.wmedia-kind{position:absolute;right:5px;bottom:5px;width:20px;height:20px;border-radius:99px;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.5);color:#fff;font-size:11px}
.wmedia-add.disabled{opacity:.5}
.wmedia-add>text{margin-top:4px}
.wmedia-note{margin-top:2px}
.wd-note-h{margin:4px 0 6px}
.wd-note{min-height:56px;width:100%;box-sizing:border-box}
.wd-gap{height:10px}
