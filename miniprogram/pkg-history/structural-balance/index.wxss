.sb-row{flex-direction:column;align-items:stretch;padding:10px 0}
.sb-row+.sb-row{border-top:var(--hair) solid var(--sep)}
.mrow.sb-row>view+view{margin-left:0;margin-top:6px}
.sb-top{display:flex;justify-content:space-between}
.sb-nm{white-space:normal;word-break:break-all;overflow:visible}
.sb-v{text-align:right;flex:none;margin-left:12px}
.sb-hint{color:var(--label-2)}
.sb-acts{display:flex;flex-wrap:wrap;gap:8px}
